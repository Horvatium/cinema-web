{
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "git": {
        "deploymentEnabled": {
            "main": false
        }
    },
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "script-src 'self' https://js.stripe.com https://m.stripe.network; frame-src 'self' https://js.stripe.com"
                }
            ]
        }
    ],
    "rewrites": [{ "source": "/(.*)", "destination": "/" }]
}
